# Lapisan pengaman kedua: file non-aplikasi tidak boleh diunduh dari browser,
# di folder mana pun (dump SQL, patch, dokumentasi, test, composer).
<FilesMatch "\.(sql|patch|diff|md|py|lock|log|bak)$|^composer\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
